# Create a dedicated test database and set a private password before running the API.
# Do not commit the real .env file.
DATABASE_URL=postgresql://iis_test:replace-me@127.0.0.1:5433/iis_test
POSTGRES_USER=iis_test
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=iis_test

# The remote simulation page requires these on the Windows test server.
# Put the private password in .env only; never commit it.
LAB_CONTROL_USER=admin
LAB_CONTROL_PASSWORD=replace-me
